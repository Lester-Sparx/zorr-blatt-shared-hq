{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "taskId", "revision", "candidateCommit", "artifactSha256", "reviewerGitHubLogin", "result", "report", "reportSha256"],
  "properties": {
    "kind": {"enum": ["QC", "ARCHITECTURE"]}, "taskId": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1}, "candidateCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "artifactSha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "reviewerGitHubLogin": {"type": "string", "minLength": 1},
    "result": {"enum": ["PASS", "PARTIAL", "FAIL", "ACCEPTED", "CHANGES_REQUIRED"]},
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "overallResult", "checks"],
      "properties": {
        "format": {"enum": ["ZB_QC_REPORT_V1", "ZB_ARCHITECTURE_REPORT_V1"]},
        "overallResult": {"enum": ["PASS", "PARTIAL", "FAIL", "ACCEPTED", "CHANGES_REQUIRED"]},
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "result"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "result": {"enum": ["PASS", "FAIL"]},
              "observed": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "reportSha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  }
}
